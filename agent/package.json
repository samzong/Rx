{
  "name": "rx-agent",
  "version": "0.2.0",
  "private": true,
  "description": "rx-agent: the Rx coding agent built on pi-agent-core and pi-ai",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rx-agent": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit && node scripts/check-syntax.ts",
    "test": "node --test 'test/**/*.test.ts' 'evals/**/*.test.ts'"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.5.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "acp-extension-core": "0.3.0",
    "typebox": "1.4.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
